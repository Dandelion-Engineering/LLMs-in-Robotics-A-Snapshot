{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:dandelion:robot-codex-behavioral-evidence:1",
  "title":"Robot-Codex public behavioral evidence records",
  "oneOf":[{"$ref":"#/$defs/event"},{"$ref":"#/$defs/version"},{"$ref":"#/$defs/content"},{"$ref":"#/$defs/source"},{"$ref":"#/$defs/anchor"},{"$ref":"#/$defs/metadata"},{"$ref":"#/$defs/workspace"},{"$ref":"#/$defs/index"}],
  "$defs":{
    "base":{"type":"object","required":["schema_version"],"properties":{"schema_version":{"const":"robot-codex-behavioral-evidence-1"},"run_id":{"type":"string","pattern":"^RCI001-C02-(stock|home)-0[1-5]$"}}},
    "nullableNumber":{"type":["number","null"]},
    "hash":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "reference":{"type":"object","required":["source_id","line","json_pointer"],"additionalProperties":false,"properties":{"source_id":{"type":"string"},"line":{"type":["integer","null"],"minimum":1},"json_pointer":{"type":"string","pattern":"^(/|$)"}}},
    "provenance":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/reference"}},
    "clock":{"type":"object","required":["wall_unix_s","recorded_sim_time_s","relation","sim_lower_s","sim_upper_s","left_anchor_event_id","right_anchor_event_id","original_timestamp_fields","exact_mutation_time_s","unknown_reason"],"properties":{"wall_unix_s":{"$ref":"#/$defs/nullableNumber"},"recorded_sim_time_s":{"$ref":"#/$defs/nullableNumber"},"sim_lower_s":{"$ref":"#/$defs/nullableNumber"},"sim_upper_s":{"$ref":"#/$defs/nullableNumber"},"relation":{"enum":["untimed","recorded_simulation","before_recording","after_stop","exact_anchor","wall_bracket"]},"left_anchor_event_id":{"type":["integer","string","null"]},"right_anchor_event_id":{"type":["integer","string","null"]},"original_timestamp_fields":{"type":"object"},"exact_mutation_time_s":{"type":"null"},"unknown_reason":{"type":["string","null"]}}},
    "event":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["run_id","id","category","kind","phase","actor","clock","ids","provenance","payload"],"properties":{"id":{"type":"string"},"category":{"enum":["task_request","message","tool_call","tool_result","tool_output","robot_request","public_mirror","observation","action_request","action_receipt","authority","controller_transition","handback","file_change","task_outcome"]},"kind":{"type":"string"},"phase":{"type":["string","null"]},"actor":{"type":["string","null"]},"clock":{"$ref":"#/$defs/clock"},"ids":{"type":"object"},"provenance":{"$ref":"#/$defs/provenance"},"payload":{"type":"object"}}}]},
    "version":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["run_id","id","path","content_sha256","bytes","content_status","evidence_class","state_assertion","clock","provenance","previous_evidenced_version_id","diff","unknown_reason"],"properties":{"path":{"type":"string"},"content_sha256":{"$ref":"#/$defs/hash"},"bytes":{"type":["integer","null"],"minimum":0},"content_status":{"enum":["retained","unknown_not_retained"]},"clock":{"$ref":"#/$defs/clock"},"provenance":{"$ref":"#/$defs/provenance"},"state_assertion":{"enum":["content_evidenced","initial_content_identity_only","corroborated_content_and_write_request","requested_content_only","retained_content_correlated_to_write_request","exact_retained_final_export"]},"evidence_class":{"type":"string"},"diff":{"type":["string","null"]}}}]},
    "content":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["run_id","sha256","bytes","encoding","text","base64","provenance"],"properties":{"sha256":{"$ref":"#/$defs/hash"},"bytes":{"type":"integer","minimum":0},"encoding":{"enum":["utf-8","base64"]},"text":{"type":["string","null"]},"base64":{"type":["string","null"]},"provenance":{"$ref":"#/$defs/provenance"}}}]},
    "source":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["run_id","source_id","original_root","original_path","repository_path","sha256","bytes","contains_excluded_private_items","scope"],"properties":{"sha256":{"$ref":"#/$defs/hash"},"bytes":{"type":"integer","minimum":0},"contains_excluded_private_items":{"type":"boolean"}}}]},
    "anchor":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["run_id","event_id","wall_unix_s","sim_time_s","provenance"],"properties":{"wall_unix_s":{"type":"number"},"sim_time_s":{"type":"number"},"provenance":{"$ref":"#/$defs/provenance"}}}]},
    "metadata":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["run_id","ordinal","challenge_family","seed","noise_seed","queue_job_id","disposition","validity","final_task_outcome","handbacks","handback_rejected","handback_accepted","agent_written_workspace_programs_used","counts","limitations","provenance"],"properties":{"ordinal":{"type":"integer","minimum":1,"maximum":20},"challenge_family":{"enum":["misplaced-stock","blocked-insert-home"]},"disposition":{"const":"valid_success"},"validity":{"const":"valid"},"final_task_outcome":{"const":"success"},"handback_rejected":{"type":"boolean"},"handback_accepted":{"type":"boolean"},"agent_written_workspace_programs_used":{"type":"boolean"},"provenance":{"$ref":"#/$defs/provenance"}}}]},
    "workspace":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["run_id","root","scope","regular_file_count","total_retained_bytes","files","directories","directory_metadata","exact_intermediate_tree","final_snapshot_timestamp","omitted_scope","provenance"],"properties":{"root":{"const":"/workspace"},"files":{"type":"array"},"regular_file_count":{"type":"integer"},"total_retained_bytes":{"type":"integer"},"provenance":{"$ref":"#/$defs/provenance"}}}]},
    "index":{"allOf":[{"$ref":"#/$defs/base"},{"type":"object","required":["campaign_id","selection","campaign_dispositions","runs","interpretation_performed","new_model_simulation_launches","provenance"],"properties":{"runs":{"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/metadata"}},"campaign_dispositions":{"type":"array","minItems":20,"maxItems":20},"interpretation_performed":{"const":false},"new_model_simulation_launches":{"const":0}}}]}
  }
}
