+        changes += [('missing-source', relative) for relative in qa.SOCKET_INTERRUPT_SOURCES]
+        changes += [('missing-input', relative) for relative in qa.SOCKET_INTERRUPT_SOURCES]
+        for change, target in changes:
+            with self.subTest(change=change, target=target):
+                row, manifest, snapshot = self.fixture()
+                m, s = json.loads(manifest.read_bytes()), json.loads(snapshot.read_bytes())
+                if change == 'dispatch':
+                    job = json.loads(self.f.queue_path.read_bytes())
