+
+    def rebind(self, row, *, bind_manifest=True):
+        self.f.refresh_single_interrupt_bindings(bind_manifest=bind_manifest)
+        for n, key in enumerate(('official_queue_sha256', 'manifest_sha256', 'snapshot_sha256')):
+            row['links'][n]['sha256'] = self.f.row['artifacts'][n]['sha256']
