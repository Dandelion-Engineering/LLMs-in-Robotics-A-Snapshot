+                    self.f.save(self.f.queue_path, job)
+                else:
+                    name = (self.f.campaign / target).relative_to(self.f.root).as_posix()
+                    if change == 'source': s['sources'][name]['sha256'] = '0' * 64
+                    elif change == 'missing-source': del s['sources'][name]
+                    else: m['runtime_input_files'].remove(name)
+                self.f.save(manifest, m); self.f.save(snapshot, s); self.rebind(row)
