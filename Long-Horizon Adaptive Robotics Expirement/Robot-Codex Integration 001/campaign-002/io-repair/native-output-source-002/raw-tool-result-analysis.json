  "findings": [
    {
      "id": "raw_option",
      "source": "thread_lifecycle.rs:319-334; session/mod.rs:3537-3666,4163-4170; bespoke_event_handling.rs:1163-1176; protocol/common.rs:1957",
      "finding": "experimentalRawEvents gates delivery of prepared ResponseItems as rawResponseItem/completed. FunctionCallOutput and CustomToolCallOutput are recorded, with thread/turn identity. Tool formatting and code-mode truncation precede this boundary. Raw item clones precede separate history truncation; no exact next-request or attention claim."
    },
    {
      "id": "direct_id",
      "source": "tools/context.rs:413-421,578-602; unified_exec/process_manager.rs:244,824-826",
      "finding": "Direct exec response call_id and native process metadata toolCallId share the dispatched call ID. Require equality, literal arguments, actual complete process bytes and exact raw payload."
    },
    {
      "id": "nested_id",
      "source": "tools/code_mode/delegate.rs:317-334; tools/code_mode/mod.rs:341-407; tools/context.rs:55-65,448-477",
      "finding": "Code-mode delegate creates independent exec-UUID. runtime_tool_call_id is per-cell and explicitly not the Codex tool call ID. Nested JSON exposes chunk_id/wall_time_seconds/exit_code/session_id/original_token_count/output, not event_call_id. H2 runtime IDs alone do not join native toolCallId. No public parent/cell field in retained installed commandExecution schema."
    },
    {
      "id": "schema_mismatch",
      "source": "tools/context.rs:83-121; bespoke_event_handling.rs:1396-1434; retained ItemCompletedNotification.json",
      "finding": "Fetched tag has model_context/originating-call features absent from retained installed schema. Version label is not build attestation. Do not use tag-only parent fields or claim installed binary source equality."
    },
    {
      "id": "h2_scope",
      "source": "grpc_session/completion.rs; tools/code_mode/mod.rs:256-326; tools/code_mode/execute_handler.rs:124-126",
      "finding": "CompleteToolCall.output_json is result delivered to JavaScript; JS need not print it. ExecuteEvent outcome is prior to core output formatting/truncation. A passive H2 parser requires framing/HPACK/gRPC/compression/stream/status handling and still cannot replace final prepared output. No H2 change recommended for this bounded repair."
    }
  ],
  "recommendation": {
    "status": "prospective_only_parent_adopted_method_separately",
    "minimum_runtime_change": "Additive bootstrap_client_v3 enabling thread/start.experimentalRawEvents with explicit receipt; preserve existing durable logging/redaction, model/config/ephemeral/historynone/network/isolation/timeouts/forwarding. Keep v2 immutable. No historical reassessment.",
    "raw_types": [
      "function_call",
      "function_call_output",
      "custom_tool_call",
      "custom_tool_call_output"
    ],
    "output_schema": "String or ordered FunctionCallOutputContentItem list. Text proof supports complete text only; reject missing call IDs, foreign identities, nontext/unknown output, duplicate keys, cap/truncation/error/redaction and incomplete events.",
    "nested_scope": "Explicit finite unique-call correlation, not authoritative parent-ID join. Single literal exec invocation + sole text/console.log whole-value or .output print; unique complete matching command in exact same-thread/turn raw call/output interval. Reject overlap, multiple calls, yielding/unresolved cells, aliases/transforms and ambiguous envelopes. No arbitrary JavaScript evaluation or substring proof.",
    "byte_rule": "Entire extracted prepared payload must equal complete authenticated stdout with empty stderr and integer0 exit; segment via existing trusted source matcher. Keep app_projection_equals_executor false when false; add separate proof only.",
    "validation": "Meaningful adversarial deterministic tests; byte/AST bootstrap parity; no-model option preflight; source/binary/schema binding; new freeze and full fresh native/boundary/smoke/pilots. Old smoke008 failure remains."
