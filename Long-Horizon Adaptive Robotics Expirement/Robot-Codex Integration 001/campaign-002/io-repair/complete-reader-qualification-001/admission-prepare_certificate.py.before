def verify_final_lineage(snapshot_path, index, paths):
    """Cross-check trusted operator records before creating any candidate or seal.

    These records extend the externally sealed certificate's provenance. They do
    not replace the independent verifier's native, boundary, smoke or pilot gates.
    """
    names = ('qualification_coordinator', 'qualification_readiness', 'qualification_preflight',
             'qualification_completion', 'qualification_index')
    bindings = {name: identity(paths[name]) for name in names}
    read = lambda path: json.loads(Path(path).read_text(encoding='utf-8-sig'))
    preflight = read(paths['qualification_preflight'])
    completed = read(paths['qualification_completion'])
    if (preflight.get('schema') != 'campaign002-final-qualification-preflight-1'
            or preflight.get('coordinator') != bindings['qualification_coordinator']
            or preflight.get('readiness') != bindings['qualification_readiness']
            or preflight.get('readiness_sha256') != bindings['qualification_readiness']['sha256']):
        raise ValueError('Qualification preflight does not bind the exact coordinator and readiness')
    if (completed.get('schema') != 'campaign002-final-qualification-completed-1'
            or not isinstance(completed.get('pilots'), list) or len(completed['pilots']) != 2
            or any(not isinstance(completed.get(key), dict) for key in ('native', 'boundary', 'smoke'))
            or any(completed.get(key) != index.get(key) for key in ('native', 'boundary', 'smoke', 'pilots'))
            or read(paths['qualification_index']) != index):
        raise ValueError('Qualification completion differs from the exact ordered qualification index')
    with qualification_validator(paths['qualification_coordinator']) as coordinator:
        readiness = coordinator.load_readiness(paths['qualification_readiness'], preflight['readiness_sha256'])
        for field in ('source_snapshot', 'stages', 'diagnostic', 'repair_test_receipt', 'transport_diagnostic',
                      'raw_event_preflight'):
            if field not in readiness or preflight.get(field) != readiness[field]:
                raise ValueError('Qualification preflight differs from declared readiness: ' + field)
        entries = [completed['native'], completed['boundary'], completed['smoke'], *completed['pilots']]
        final_snapshot = identity(snapshot_path)
        for stage, entry in zip(readiness['stages'], entries):
            name, kind, revision, seed = stage
            expected = coordinator.entry_for(name, kind, revision)
            if not isinstance(entry, dict):
                raise ValueError('Malformed completed qualification entry: ' + name)
            for key in ('manifest', 'snapshot', 'queue', 'assessment'):
                if not isinstance(entry.get(key), dict) or entry[key].get('path') != str(expected[key].resolve()):
                    raise ValueError('Completed qualification stage path differs: ' + name + '/' + key)
            if entry.get('evidence') != str(expected['evidence'].resolve()):
                raise ValueError('Completed qualification evidence differs: ' + name)
            manifest = read(coordinator.admission.artifact(entry['manifest']))
            frozen = read(coordinator.admission.artifact(entry['snapshot']))
            if (manifest.get('run_id') != expected['run_id'] or manifest.get('framework_revision') != revision
                    or frozen.get('revision') != revision):
                raise ValueError('Completed qualification identity or revision differs: ' + name)
            if kind not in ('native', 'boundary'):
                if (entry['snapshot'] != final_snapshot or type(manifest.get('noise_seed')) is not int
                        or manifest['noise_seed'] != seed
                        or entry.get('host_evidence') != str(expected['host'].resolve())):
                    raise ValueError('Completed model qualification final source, seed or host differs: ' + name)
                if kind in ('stock', 'home') and entry.get('family') != {
                        'stock': 'misplaced-stock', 'home': 'blocked-insert-home'}[kind]:
                    raise ValueError('Completed pilot family differs: ' + name)
        coordinator.assert_sources(readiness, snapshot_path)
        # The existing helper authenticates official integer-zero completion before
        # reading the diagnostic result, then independently replays the three fixed cases.
        coordinator.verify_transport_probe(readiness['transport_diagnostic'],
                                            coordinator.admission.artifact(readiness['source_snapshot']))
        coordinator.verify_raw_preflight(readiness['raw_event_preflight'],
                                         coordinator.admission.artifact(readiness['source_snapshot']))
    if any(identity(paths[name]) != binding for name, binding in bindings.items()):
        raise ValueError('Qualification lineage changed during pre-seal validation')
    return bindings


def publish_seal(raw, digest, revision):
    """Expose certificate and seal together; interrupted staging stays distinct."""
    final = HERE / 'sealed-v1'
    pending = HERE / 'sealed-v1.pending'
    if final.exists() or pending.exists():
        raise ValueError('Existing seal or pending seal is immutable; reconcile it explicitly')
    pending.mkdir()
    save(pending / 'certificate.json', raw)
    save(pending / 'seal.json', (json.dumps({'schema': 'campaign002-seal-1', 'certificate_sha256': digest,
         'source_revision': revision, 'release_revision': 'RCI001-C02-frozen-001',
         'sealed_utc': datetime.now(timezone.utc).isoformat()}, indent=2) + '\n').encode('utf-8'))
    os.rename(pending, final)
    return final / 'certificate.json'


def prepare(snapshot_path, qualification_index, candidate, *, schedule=None, execution_plan=None, candidate_only=False):
    snapshot_path, qualification_index, candidate = map(Path, (snapshot_path, qualification_index, candidate))
    schedule = Path(schedule) if schedule is not None else CAMPAIGN / 'predeclared-v1/schedule.json'
    execution_plan = Path(execution_plan) if execution_plan is not None else CAMPAIGN / 'execution-plan.json'
    if (HERE / 'sealed-v1').exists() or (HERE / 'sealed-v1.pending').exists():
        raise ValueError('Existing seal or pending seal is immutable; reconcile it explicitly')
    if candidate.exists():
        raise FileExistsError(candidate)
    snapshot = json.loads(snapshot_path.read_text(encoding='utf-8-sig'))
    plan = json.loads(execution_plan.read_text(encoding='utf-8-sig'))
    index = json.loads(qualification_index.read_text(encoding='utf-8-sig'))
    if (plan.get('schema') != 'campaign002-execution-plan-1' or plan.get('campaign_id') != 'RCI001-Campaign002'
            or plan.get('framework_revision') != snapshot.get('revision')
            or plan.get('release_revision') != 'RCI001-C02-frozen-001'):
        raise ValueError('Execution plan source or release revision differs from final snapshot')
    if (index.get('schema') != 'campaign002-qualification-index-1'
            or index.get('source_revision') != snapshot.get('revision')
            or index.get('final_source_snapshot') != identity(snapshot_path)):
        raise ValueError('Qualification index is not bound to this final source snapshot')
    paths = artifact_paths(snapshot_path, qualification_index, schedule)
    paths['execution_plan'] = execution_plan
    lineage = verify_final_lineage(snapshot_path, index, paths)
    approval = HERE / 'approval-source.md'
    if not approval.exists():
        source = REPO / 'chats/Codex-Human/Robot-Codex Campaign 002/Robot-Codex Campaign 002 - Active.md'
        save(approval, source.read_bytes())
    artifacts = {key: identity(path) for key, path in paths.items()}
    if any(artifacts[key] != binding for key, binding in lineage.items()):
        raise ValueError('Qualification lineage changed before candidate creation')
    value = {'schema': 'campaign002-admission-1', 'created_at': datetime.now(timezone.utc).isoformat(),
             'campaign_id': 'RCI001-Campaign002', 'source_revision': snapshot['revision'],
             'release_revision': 'RCI001-C02-frozen-001', 'artifacts': artifacts,
             'attempts': plan['attempts'], 'scope': 'Twenty fresh known-fixture repeats of the unchanged Robot-Codex recovery inputs. All qualification, prospective evidence corrections and operator sources are bound before the first scored launch.'}
    raw = (json.dumps(value, indent=2, allow_nan=False) + '\n').encode('utf-8')
    candidate.parent.mkdir(parents=True, exist_ok=True)
    save(candidate, raw)
    digest = hashlib.sha256(raw).hexdigest()
    load_verifier().verify_certificate(candidate, digest)
    certificate = candidate if candidate_only else publish_seal(raw, digest, snapshot['revision'])
    return {'certificate_sha256': digest, 'certificate': str(certificate.resolve()),
            'attempts': len(plan['attempts']), 'sealed': not candidate_only}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--snapshot', type=Path, required=True)
    parser.add_argument('--qualification-index', type=Path, required=True)
    parser.add_argument('--candidate', type=Path, required=True)
    parser.add_argument('--schedule', type=Path)
    parser.add_argument('--execution-plan', type=Path)
    parser.add_argument('--candidate-only', action='store_true', help='Verify and retain a candidate without publishing the final seal')
    args = parser.parse_args(argv)
    print(json.dumps(prepare(args.snapshot, args.qualification_index, args.candidate,
        schedule=args.schedule, execution_plan=args.execution_plan, candidate_only=args.candidate_only)))


if __name__ == '__main__':
    main()
