"""Bind completed qualification and twenty manifests; never launch a run."""
import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import sys

HERE = Path(__file__).resolve().parent
CAMPAIGN = HERE.parent
RCI = CAMPAIGN.parent
REPO = RCI.parents[1]


def identity(path):
    path = Path(path).resolve()
    return {'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}


def save(path, raw):
    with Path(path).open('xb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())


def load_verifier():
    spec = importlib.util.spec_from_file_location('certificate_admission', CAMPAIGN / 'admission.py')
    verifier = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(verifier)
    return verifier


@contextmanager
def qualification_validator(path):
    """Use the fixed coordinator's read-only helpers without leaking its path edits."""
    original_path = sys.path[:]
    try:
        spec = importlib.util.spec_from_file_location('certificate_final_qualification', path)
        coordinator = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(coordinator)
        for name in ('admission', 'operate'):
            module_path = Path(getattr(coordinator, name).__file__).resolve()
            if module_path != (CAMPAIGN / (name + '.py')).resolve():
                raise ValueError('Qualification validator imported a different operator module: ' + name)
        yield coordinator
    finally:
        sys.path[:] = original_path


