+def archived_pilot_assessor(member, snapshot, snapshot_item, assessor_item, archive_raw):
+    """Join a retained copy to one exact authenticated source member; never execute it."""
+    expected_member = (CAMPAIGN / 'assessment/assess.py').relative_to(REPO).as_posix()
+    if (not isinstance(member, str) or member != expected_member or '\\' in member
+            or ':' in member or PurePosixPath(member).is_absolute()
+            or any(part in ('', '.', '..') for part in member.split('/'))):
+        raise ValueError('Pilot archived source member must name the exact campaign assessor')
+    def unique(pairs):
+        value = {}
+        for key, item in pairs:
+            if key in value:
+                raise ValueError('Duplicate pilot archived source member snapshot key')
+            value[key] = item
+        return value
+    strict_snapshot = json.loads(bound(snapshot_item, 'pilot archived source member snapshot', parse=False),
+                                 object_pairs_hook=unique)
+    source = strict_snapshot.get('sources', {}).get(member)
+    if (strict_snapshot != snapshot or not isinstance(source, dict) or set(source) != {'sha256', 'bytes'}
+            or type(source.get('bytes')) is not int or not 0 < source['bytes'] <= MAX_BYTES
+            or source['sha256'] != assessor_item['sha256']
+            or type(assessor_item.get('bytes')) is not int or source['bytes'] != assessor_item['bytes']):
+        raise ValueError('Pilot archived source member identity or byte count differs')
+    try:
+        with zipfile.ZipFile(io.BytesIO(archive_raw)) as archive:
+            entries = archive.infolist()
+            names = [item.filename for item in entries]
+            if len(names) != len(set(names)) or len(names) != len({name.casefold() for name in names}):
+                raise ValueError('Duplicate pilot archived source member')
+            matches = [item for item in entries if item.filename == member]
+            if len(matches) != 1 or matches[0].is_dir() or matches[0].file_size != source['bytes']:
+                raise ValueError('Pilot archived source member missing or wrong length')
+            with archive.open(matches[0]) as stream:
+                raw = stream.read(source['bytes'] + 1)
+    except zipfile.BadZipFile as error:
+        raise ValueError('Pilot archived source member archive is malformed') from error
+    if (len(raw) != source['bytes'] or sha(raw) != source['sha256']
+            or raw != bound(assessor_item, 'exact retained archived pilot assessor bytes', parse=False)):
+        raise ValueError('Pilot archived source member differs from retained copy')
+
