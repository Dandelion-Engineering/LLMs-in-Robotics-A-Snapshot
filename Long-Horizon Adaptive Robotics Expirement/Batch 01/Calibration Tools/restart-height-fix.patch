+            self.assertTrue(event['configured_milestone_exercised'])
+            self.assertIsNone(event['measured_tcp_z_m'])
+            checked.add(cut)
+        self.assertEqual(checked,set(RestartOpportunity.PHASES)-{'closed_grip_transfer'})
+
 
