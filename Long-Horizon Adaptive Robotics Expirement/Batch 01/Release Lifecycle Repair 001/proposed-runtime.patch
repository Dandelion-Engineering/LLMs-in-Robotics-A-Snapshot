+def fake_model():
+    model=LocalModel()
+    model.process=MagicMock()
+    model.process.pid=27772
+    model.process.poll.return_value=None
+    model._manifest={'installed_files':[{'path':'server.exe','sha256':'synthetic'}],
+                     'server_relative_path':'server.exe'}
